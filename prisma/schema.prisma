generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Identity & Access Management
// -----------------------------------------------------------------------------

model User {
  id              Int       @id @default(autoincrement())
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  email           String    @unique
  passwordHash    String    @map("password_hash")
  refreshToken  String?   // <-- Add this
  profileImageUrl String?   @map("profile_image_url")
  status          String    @default("active")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  otp             String?
  otpExpires      DateTime? @map("otp_expires")
  passwordResetOtp String?  @map("password_reset_otp")
  passwordResetOtpExpires DateTime? @map("password_reset_otp_expires")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  userRoles      UserRole[]
  instructor     Instructor?
  student        Student?
  hodDepartments Department[]    @relation("HODUser")
  createdCourses Course[]        @relation("CourseCreator")
  uploadedItems  CourseContent[] @relation("ContentUploader")
  managedSocieties Society[]     @relation("SocietyIncharge")
  societyMemberships SocietyMember[]
  createdEvents  SocietyEvent[]  @relation("EventCreator")

  @@map("users")
}

model Role {
  id       Int    @id @default(autoincrement())
  roleName String @unique @map("role_name")

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

// 2. Organizational Structure
// -----------------------------------------------------------------------------

model Department {
  id        Int      @id @default(autoincrement())
  code      String   @unique // (CS, EE)
  name      String   @unique
  hodUserId Int     @map("hod_user_id")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  hod         User?        @relation("HODUser", fields: [hodUserId], references: [id])
  programs    Program[]
  students    Student[]
  instructors Instructor[]
  courses     Course[]

  @@map("departments")
}

model Program {
  id            Int      @id @default(autoincrement())
  code          String   @unique // (CS, SE, AI)
  name          String
  departmentId  Int      @map("department_id")
  durationYears Int      @map("duration_years")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  department Department @relation(fields: [departmentId], references: [id])
  students   Student[]

  @@map("programs")
}

// 3. People
// -----------------------------------------------------------------------------

model Instructor {
  userId       Int    @id @map("user_id")
  employeeNo   String @unique @map("employee_no")
  departmentId Int    @map("department_id")

  // Relations
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department         @relation(fields: [departmentId], references: [id])
  courses    CourseInstructor[]

  @@map("instructors")
}

model Student {
  userId         Int      @id @map("user_id")
  agNo           String   @unique @map("ag_no")
  departmentId   Int      @map("department_id")
  admissionDate  DateTime @default(now()) @map("admission_date")
  programId      Int      @map("program_id")

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department   @relation(fields: [departmentId], references: [id])
  program     Program      @relation(fields: [programId], references: [id])
  enrollments Enrollment[]

  @@map("students")
}

// 4. Academics
// -----------------------------------------------------------------------------

model AcademicTerm {
  id        Int      @id @default(autoincrement())
  name      String   // Fall 24, Spring 24
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  enrollments   Enrollment[]
  termMappings  AcademicTermMapping[]
  courses       Course[] // Direct relation from image fields

  @@map("academic_terms")
}

model Course {
  id             Int      @id @default(autoincrement())
  code           String   @unique // (CS-414)
  title          String
  description    String?
  creditHours    Int      @map("credit_hours")
  departmentId   Int      @map("department_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      Int      @map("created_by") // Instructor_id
  updatedAt      DateTime @updatedAt @map("updated_at")
  isActive       Boolean  @default(true) @map("is_active")
  academicTermId Int?     @map("academic_term_id")

  // Relations
  department   Department         @relation(fields: [departmentId], references: [id])
  creator      User               @relation("CourseCreator", fields: [createdBy], references: [id])
  academicTerm AcademicTerm?      @relation(fields: [academicTermId], references: [id])
  instructors  CourseInstructor[]
  contents     CourseContent[]
  enrollments  Enrollment[]
  termMappings AcademicTermMapping[]

  @@map("courses")
}

model AcademicTermMapping {
  id             Int     @id @default(autoincrement())
  courseId       Int     @map("course_id")
  academicTermId Int     @map("academic_term_id")
  isActive       Boolean @default(true) @map("is_active")

  // Relations
  course       Course       @relation(fields: [courseId], references: [id])
  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id])

  @@map("academic_term_mappings")
}

model CourseInstructor {
  courseId         Int @map("course_id")
  instructorUserId Int @map("instructor_user_id")

  // Relations
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorUserId], references: [userId], onDelete: Cascade)

  @@id([courseId, instructorUserId])
  @@map("course_instructors")
}

model CourseContent {
  id          Int      @id @default(autoincrement())
  courseId    Int      @map("course_id")
  title       String
  description String?
  youtubeUrl  String?  @map("youtube_url")
  uploadedBy  Int      @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploader User   @relation("ContentUploader", fields: [uploadedBy], references: [id])

  @@map("course_contents")
}

model Enrollment {
  id            Int      @id @default(autoincrement())
  studentUserId Int      @map("student_user_id")
  enrolledAt    DateTime @default(now()) @map("enrolled_at")
  courseId      Int      @map("course_id")
  status        String?  @default("enrolled") // enrolled, completed, dropped, failed
  academicTermId Int     @map("academic_term_id")

  // Relations
  student      Student      @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id])

  @@unique([studentUserId, courseId])
  @@map("enrollments")
}

// 5. Extra-Curricular
// -----------------------------------------------------------------------------

model Society {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  description    String?
  logoUrl        String?  @map("logo_url")
  inchargeUserId Int?     @map("incharge_user_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  incharge     User?           @relation("SocietyIncharge", fields: [inchargeUserId], references: [id])
  members      SocietyMember[]
  events       SocietyEvent[]

  @@map("societies")
}

model SocietyPosition {
  id           Int    @id @default(autoincrement())
  name         String @unique
  displayOrder Int    @map("display_order")

  // Relations
  members SocietyMember[]

  @@map("society_positions")
}

model SocietyMember {
  id         Int     @id @default(autoincrement())
  societyId  Int     @map("society_id")
  userId     Int     @map("user_id")
  positionId Int     @map("position_id")
  isActive   Boolean @default(true) @map("is_active")

  // Relations
  society  Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  position SocietyPosition @relation(fields: [positionId], references: [id])

  @@unique([societyId, userId])
  @@map("society_members")
}

model SocietyEvent {
  id          Int      @id @default(autoincrement())
  societyId   Int      @map("society_id")
  title       String
  description String?
  eventDate   DateTime @map("event_date")
  eventTime   String   @map("event_time") // Stored as string for time format
  posterUrl   String?  @map("poster_url")
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  creator User    @relation("EventCreator", fields: [createdBy], references: [id])

  @@map("society_events")
}